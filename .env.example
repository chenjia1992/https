# copy this file to .env and fill in values

ACCOUNT_EMAIL=example@example.com
# DNS provider: "cloudflare" or "aliyun"
DNS_PROVIDER=cloudflare

# for Cloudflare DNS API (required if provider=cloudflare)
CLOUDFLARE_API_TOKEN=your_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_here

# for Alibaba Cloud DNS (required if provider=aliyun)
ALIYUN_ACCESS_KEY_ID=your_access_key
ALIYUN_ACCESS_KEY_SECRET=your_secret_key

# Optional overrides
DOMAIN=*.example.com
CERT_DIR=./ssl